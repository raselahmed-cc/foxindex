# Copy to .env and adjust. Local dev values match infrastructure/docker/docker-compose.dev.yml.
# In staging/production, only DATABASE_URL/REDIS_URL/SMTP_* change (Neon/Upstash/real SMTP) —
# no code changes required.

NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Database (Postgres — Neon in staging/prod, local container in dev) ---
DATABASE_URL=postgres://foxindex:foxindex@localhost:5432/foxindex

# --- Redis (Upstash in staging/prod, local container in dev) ---
REDIS_URL=redis://localhost:6379

# --- Auth (JWT + argon2, docs/adr/0014) ---
JWT_SECRET=dev-only-change-me-to-a-long-random-string
ENCRYPTION_KEY=dev-only-encryption-key-change-me
API_PUBLIC_URL=http://localhost:3001
# aamarPay (optional). Leave empty to disable gateway checkout. Sandbox test creds: store "aamarpaytest".
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
AAMARPAY_SANDBOX=true

# --- Outbound email (MailDev in dev; a real SMTP relay in staging/prod) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FoxIndex <no-reply@foxindex.dev>"

# --- Providers ---
# Shared multi-engine IndexNow endpoint (Bing/Yandex/Naver/Seznam/Yep). Overridden to a
# local mock server only in the E2E test compose override — never in production.
INDEXNOW_API_BASE_URL=https://api.indexnow.org/indexnow

# --- Worker concurrency ---
SUBMISSION_WORKER_CONCURRENCY=5
VERIFICATION_WORKER_CONCURRENCY=5

# --- SSRF fetch (test-only escape hatch; leave unset in every real environment) ---
# SSRF_FETCH_ALLOW_PRIVATE=true
