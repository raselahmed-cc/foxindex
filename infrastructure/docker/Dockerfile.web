# NEXT_PUBLIC_* variables are inlined into the client bundle at BUILD time,
# not read at container start — this build arg must match wherever the
# browser will actually reach the API (Caddy's public origin in production,
# not the internal `api` service name).
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN pnpm --filter @foxindex/web build

FROM node:22-alpine AS runtime
RUN corepack enable
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
EXPOSE 3000
CMD ["pnpm", "--filter", "@foxindex/web", "start"]
