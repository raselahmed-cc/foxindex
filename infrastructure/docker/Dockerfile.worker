# Background worker image, parameterized by WORKER_NAME (today: "submission").
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ARG WORKER_NAME=submission
RUN pnpm --filter @foxindex/worker-${WORKER_NAME}... build
RUN CI=true pnpm install --prod --frozen-lockfile --offline

FROM node:22-alpine AS runtime
RUN apk add --no-cache tini
WORKDIR /app
ENV NODE_ENV=production
ARG WORKER_NAME=submission
ENV WORKER_NAME=${WORKER_NAME}
ENV WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat
COPY --from=build --chown=node:node /app /app
USER node
# The worker touches its heartbeat file every 15 s; stale for 60 s = unhealthy.
HEALTHCHECK --interval=20s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "const s=require('fs').statSync(process.env.WORKER_HEARTBEAT_FILE);process.exit(Date.now()-s.mtimeMs<60000?0:1)"
ENTRYPOINT ["/sbin/tini", "--"]
# Shell form so ${WORKER_NAME} is substituted at container start.
CMD node workers/${WORKER_NAME}/dist/main.js
