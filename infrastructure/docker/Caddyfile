# Local dev: plain HTTP on :80. Caddy round-robins across however many api/
# web replicas `docker compose up --scale` started, via Docker's embedded
# per-service DNS (api/web resolve to all of that service's containers) —
# this is what makes horizontal scaling work without reconfiguring Caddy.
:80 {
	handle /api/* {
		reverse_proxy api:3001
	}
	handle {
		reverse_proxy web:3000
	}
}
