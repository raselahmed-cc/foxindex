# Copy to .env.production (never commit it) and fill in every value.
# Generate secrets with:  openssl rand -base64 48

# Public domain (DNS A/AAAA record → this server). Caddy gets the TLS certificate.
DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
IMAGE_TAG=latest

# Bundled Postgres + Redis (or point the URLs at managed services and set DATABASE_SSL=true)
POSTGRES_USER=foxindex
POSTGRES_PASSWORD=
POSTGRES_DB=foxindex
DATABASE_URL=postgres://foxindex:${POSTGRES_PASSWORD}@postgres:5432/foxindex
DATABASE_SSL=false
DATABASE_POOL_MAX=20
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Secrets — at least 32 random characters each, all different.
JWT_SECRET=
# Decrypts stored Google service-account keys. Back it up; losing it means re-adding them.
ENCRYPTION_KEY=

# Transactional email (verification codes, notifications).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FoxIndex <no-reply@example.com>"

# Card payments via aamarPay (optional — leave the IDs empty to disable).
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
AAMARPAY_SANDBOX=false

# First superadmin (used once by the `seed` service).
SEED_SUPERADMIN_EMAIL=
SEED_PASSWORD=

# Tuning
LOG_LEVEL=info
SUBMISSION_WORKER_CONCURRENCY=4
# Private networks are trusted as proxies (Caddy on the Docker network).
TRUST_PROXY=uniquelocal
API_DOCS_ENABLED=false
