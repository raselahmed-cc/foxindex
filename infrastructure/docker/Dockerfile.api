# Build context is the repo root (see docker-compose.dev.yml's `context: ../..`)
# — the whole workspace is needed since apps/api depends on several
# packages/* via pnpm's workspace protocol.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @foxindex/api... build

# Runtime stage still carries the full node_modules tree (incl.
# devDependencies) rather than a pruned deploy — correct and simple for
# Phase 1; image-size optimization via `pnpm deploy`/`turbo prune` is a
# documented future improvement (constitution §28: don't optimize before
# there's a measured reason to).
FROM node:22-alpine AS runtime
RUN corepack enable
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
EXPOSE 3001
CMD ["node", "apps/api/dist/bootstrap.js"]
