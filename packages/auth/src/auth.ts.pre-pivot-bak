import { betterAuth } from 'better-auth';
import { drizzleAdapter } from 'better-auth/adapters/drizzle';
import { eq, sql } from 'drizzle-orm';
import { createDbClient, creditLedger, user as userTable } from '@foxindex/database';
import { STARTER_CREDIT_BALANCE } from '@foxindex/config';
import { CreditLedgerReason } from '@foxindex/types';
import { createMailer } from './mailer';

const { db } = createDbClient({
  connectionString: process.env.DATABASE_URL ?? 'postgres://foxindex:foxindex@localhost:5432/foxindex',
});

const mailer = createMailer({
  host: process.env.SMTP_HOST ?? 'localhost',
  port: Number(process.env.SMTP_PORT ?? 1025),
  user: process.env.SMTP_USER,
  pass: process.env.SMTP_PASS,
  from: process.env.SMTP_FROM ?? 'FoxIndex <no-reply@foxindex.dev>',
});

/**
 * Phase 1 capabilities only: email/password, sessions, email verification,
 * password reset (constitution §19). OAuth/OIDC/SAML/SCIM/MFA are Phase 2+.
 */
export const auth = betterAuth({
  database: drizzleAdapter(db, { provider: 'pg' }),
  secret: process.env.BETTER_AUTH_SECRET,
  baseURL: process.env.BETTER_AUTH_URL,
  // Better Auth only trusts its own baseURL's origin by default — the web
  // app calls it cross-origin (different port), so that origin must be
  // listed explicitly or every request gets rejected as "Invalid origin"
  // regardless of CORS headers, which is a separate check Better Auth does
  // on top of CORS, not instead of it.
  trustedOrigins: [process.env.CORS_ORIGIN ?? 'http://localhost:3000'],
  // Global, per-user fields (docs/adr/0013) — not per-organization anymore,
  // since there's no organization concept left. `input: false` on both is
  // load-bearing: without it, a signup request could set its own `role` or
  // `creditBalance` in the request body and grant itself admin/free credits.
  user: {
    additionalFields: {
      role: { type: 'string', required: false, defaultValue: 'USER', input: false },
      creditBalance: { type: 'number', required: false, defaultValue: 0, input: false },
    },
  },
  // Starter-credit grant (docs/adr/0013) — replaces the old
  // OrganizationsRepository.createWithOwner() transactional grant, since
  // there's no "organization just created" moment left. This is the only
  // "a user just signed up" hook Better Auth exposes; the ledger row (not
  // just the balance bump) is what makes it show up in /credits history.
  databaseHooks: {
    user: {
      create: {
        after: async (createdUser) => {
          await db.transaction(async (tx) => {
            await tx
              .update(userTable)
              .set({ creditBalance: sql`${userTable.creditBalance} + ${STARTER_CREDIT_BALANCE}` })
              .where(eq(userTable.id, createdUser.id));
            await tx.insert(creditLedger).values({
              userId: createdUser.id,
              delta: STARTER_CREDIT_BALANCE,
              reason: CreditLedgerReason.SIGNUP_BONUS,
            });
          });
        },
      },
    },
  },
  emailAndPassword: {
    enabled: true,
    requireEmailVerification: true,
    sendResetPassword: async ({ user, url }) => {
      await mailer.send(
        user.email,
        'Reset your FoxIndex password',
        `<p>Reset your password: <a href="${url}">${url}</a></p>`,
      );
    },
  },
  emailVerification: {
    sendOnSignUp: true,
    autoSignInAfterVerification: true,
    sendVerificationEmail: async ({ user, url }) => {
      await mailer.send(
        user.email,
        'Verify your FoxIndex email',
        `<p>Verify your email: <a href="${url}">${url}</a></p>`,
      );
    },
  },
});
