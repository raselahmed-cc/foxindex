{
  "name": "@foxindex/auth",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:generate": "better-auth generate --config src/auth.ts --output ../database/src/schema/auth.ts -y"
  },
  "dependencies": {
    "@foxindex/config": "workspace:*",
    "@foxindex/database": "workspace:*",
    "@foxindex/logger": "workspace:*",
    "@foxindex/types": "workspace:*",
    "better-auth": "1.4.22",
    "nodemailer": "9.0.6"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.22",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
